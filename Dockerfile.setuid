FROM oven/bun:1-alpine AS webui-build

WORKDIR /src
COPY webui/ webui/
COPY nanobot/web/ nanobot/web/
RUN cd webui && bun install && bun run build


FROM ghcr.io/astral-sh/uv:python3.12-alpine AS python-build

RUN apk add --no-cache \
        build-base \
        ca-certificates \
        cargo \
        git \
        jpeg-dev \
        libffi-dev \
        libxml2-dev \
        libxslt-dev \
        openssl-dev \
        zlib-dev

WORKDIR /app

# Install Python dependencies first for better layer caching.
COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md hatch_build.py ./
RUN mkdir -p nanobot bridge && touch nanobot/__init__.py && \
    NANOBOT_SKIP_WEBUI_BUILD=1 uv pip install --system --no-cache . && \
    rm -rf nanobot bridge

COPY nanobot/ nanobot/
COPY --from=webui-build /src/nanobot/web/dist nanobot/web/dist
COPY bridge/ bridge/
RUN uv pip install --system --no-cache .


FROM python:3.12-alpine

RUN apk add --no-cache \
        bash \
        bubblewrap \
        ca-certificates \
        coreutils \
        curl \
        diffutils \
        file \
        findutils \
        gawk \
        git \
        grep \
        jq \
        libjpeg-turbo \
        libxml2 \
        libxslt \
        openssh-client \
        patch \
        procps \
        ripgrep \
        sed \
        setpriv \
        tar \
        unzip \
        xz

WORKDIR /app

COPY --from=python-build /usr/local /usr/local

COPY entrypoint.setuid.sh /usr/local/bin/entrypoint.setuid.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.setuid.sh && \
    chmod +x /usr/local/bin/entrypoint.setuid.sh && \
    mkdir -p /home/nanobot/.nanobot

ENV HOME=/home/nanobot

# Gateway health endpoint and optional WebUI/WebSocket channel ports.
EXPOSE 18790 8765

ENTRYPOINT ["entrypoint.setuid.sh"]
CMD ["status"]
